#!/usr/bin/env bash
# DVStudio pre-push hook
#
# 1. Prevents direct pushes to the protected branches `main` and `dev`.
# 2. Runs quality checks (typecheck + test) before pushing to feature branches.
#
# To disable branch protection temporarily:
#   DWEB_GIT_ALLOW_DIRECT_PUSH=1 git push ...
#
# To skip quality checks temporarily:
#   DWEB_SKIP_QUALITY_CHECK=1 git push ...
#
# To install this hook run `npm run git:setup-hooks`.

set -euo pipefail

# Redirect all stdout to stderr — required for Windows PowerShell / non-TTY environments
# where stdout may be closed or in a broken state before printf writes to it.
exec 1>&2

PROTECTED_BRANCHES=("main" "dev")
COLOR_RED='\033[0;31m'
COLOR_YELLOW='\033[1;33m'
COLOR_GREEN='\033[0;32m'
COLOR_CYAN='\033[0;36m'
COLOR_NONE='\033[0m'

echo_info() { printf "${COLOR_CYAN}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }
echo_warn() { printf "${COLOR_YELLOW}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }
echo_error() { printf "${COLOR_RED}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }
echo_success() { printf "${COLOR_GREEN}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }

SKIP_QUALITY="${DWEB_SKIP_QUALITY_CHECK:-0}"

if [ "${DWEB_GIT_ALLOW_DIRECT_PUSH:-0}" = "1" ]; then
  echo_warn "DWEB_GIT_ALLOW_DIRECT_PUSH=1 检测到：允许绕过分支保护直接推送。"
  if [ "$SKIP_QUALITY" = "1" ]; then
    echo_warn "DWEB_SKIP_QUALITY_CHECK=1 检测到：跳过质量检查。"
    exit 0
  fi
  echo_info "运行质量检查..."
  if npm run quality 2>&1; then
    echo_success "质量检查通过。"
    exit 0
  else
    echo_error "质量检查未通过，推送已取消。"
    echo "若确需跳过，请设置 DWEB_SKIP_QUALITY_CHECK=1"
    exit 1
  fi
fi

input_stdin="$(cat || true)"
if [ -z "${input_stdin}" ]; then
  echo_info "未检测到待推送的引用，跳过保护检测。"
  exit 0
fi

target_branch=""
while IFS= read -r line; do
  # shellcheck disable=SC2086
  set -- ${line}
  local_ref="$1"
  remote_ref="$3"
  branch_name="${remote_ref#refs/heads/}"
  for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [ "${branch_name}" = "${protected}" ]; then
      target_branch="${protected}"
      break 2
    fi
  done
done <<EOF
${input_stdin}
EOF

if [ -n "${target_branch}" ]; then
  echo_error "检测到向受保护分支『${target_branch}』的直接推送，已拒绝。"
  echo ""
  echo "工作流规则：main / dev 分支仅接受来自 Pull Request 的合并提交。"
  echo "请使用如下流程替代直接 push："
  echo ""
  echo "  1) 从 dev 拉取特性分支："
  echo "       git checkout dev"
  echo "       git pull origin dev"
  echo "       git checkout -b feature/<你的功能说明>"
  echo "  2) 在特性分支提交改动，推送到远端："
  echo "       git add ... && git commit ..."
  echo "       git push -u origin feature/<你的功能说明>"
  echo "  3) 在 Git 仓库平台（如 GitHub / Gitee）发起 Pull Request，"
  echo "     目标分支为 dev；待 Review / CI 通过后再由维护者合并。"
  echo ""
  echo "若你确实需要临时绕过该保护（例如紧急热修复），可一次性设置环境变量："
  echo ""
  echo "       DWEB_GIT_ALLOW_DIRECT_PUSH=1 git push origin dev"
  echo ""
  exit 1
fi

if [ "$SKIP_QUALITY" = "1" ]; then
  echo_warn "DWEB_SKIP_QUALITY_CHECK=1 检测到：跳过质量检查。"
  echo_info "未命中受保护分支 (main/dev)，推送继续。"
  exit 0
fi

echo_info "运行质量检查 (typecheck + test)..."
if npm run quality 2>&1; then
  echo_success "质量检查通过。"
  echo_info "未命中受保护分支 (main/dev)，推送继续。"
  exit 0
else
  echo_error "质量检查未通过，推送已取消。"
  echo ""
  echo "请修复上述问题后再推送，或临时跳过检查："
  echo ""
  echo "       DWEB_SKIP_QUALITY_CHECK=1 git push"
  echo ""
  exit 1
fi
