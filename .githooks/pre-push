#!/usr/bin/env bash
# DVStudio pre-push hook
#
# 1. Prevents direct pushes to the protected branches `main` and `dev`.
# 2. Runs Prettier format check on changed files before pushing.
# 3. Runs quality checks (typecheck + test) before pushing to feature branches.
#
# To disable branch protection temporarily:
#   DWEB_GIT_ALLOW_DIRECT_PUSH=1 git push ...
#
# To skip quality checks temporarily:
#   DWEB_SKIP_QUALITY_CHECK=1 git push ...
#
# To install this hook run `npm run git:setup-hooks`.

set -euo pipefail

# Redirect all stdout to stderr — required for Windows PowerShell / non-TTY environments
# where stdout may be closed or in a broken state before printf writes to it.
exec 1>&2

PROTECTED_BRANCHES=("main" "dev")
COLOR_RED='\033[0;31m'
COLOR_YELLOW='\033[1;33m'
COLOR_GREEN='\033[0;32m'
COLOR_CYAN='\033[0;36m'
COLOR_NONE='\033[0m'

echo_info() { printf "${COLOR_CYAN}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }
echo_warn() { printf "${COLOR_YELLOW}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }
echo_error() { printf "${COLOR_RED}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }
echo_success() { printf "${COLOR_GREEN}[dvstudio/git]${COLOR_NONE} %s\n" "$*"; }

# Run Prettier format check on files changed vs origin/dev (mirrors CI logic)
check_prettier_format() {
  local base_ref="origin/dev"
  if ! git rev-parse --verify "$base_ref" >/dev/null 2>&1; then
    base_ref="origin/main"
  fi
  if ! git rev-parse --verify "$base_ref" >/dev/null 2>&1; then
    echo_warn "无法找到 $base_ref，跳过 Prettier 格式检查（建议先 git fetch origin dev）。"
    return 0
  fi

  # Get list of changed files matching prettier-supported extensions (same as CI)
  local changed_files
  changed_files=$(git diff --name-only --diff-filter=ACMRTUXB "$base_ref"...HEAD -- '*.ts' '*.vue' '*.css' '*.json' '*.mjs' '*.js' '*.yml' 2>/dev/null | grep -v 'package-lock.json' | tr '\n' ' ')

  if [ -z "${changed_files// /}" ]; then
    echo_info "未检测到需格式化的变更文件，跳过 Prettier 检查。"
    return 0
  fi

  echo_info "运行 Prettier 格式检查 (变更文件)..."
  if npx prettier --check $changed_files 2>&1; then
    echo_success "Prettier 格式检查通过。"
    return 0
  else
    echo_error "Prettier 格式检查未通过，推送已取消。"
    echo ""
    echo "请运行以下命令自动修复格式问题："
    echo ""
    echo "       npx prettier --write $changed_files"
    echo ""
    echo "或临时跳过检查："
    echo ""
    echo "       DWEB_SKIP_QUALITY_CHECK=1 git push"
    echo ""
    return 1
  fi
}

SKIP_QUALITY="${DWEB_SKIP_QUALITY_CHECK:-0}"

if [ "${DWEB_GIT_ALLOW_DIRECT_PUSH:-0}" = "1" ]; then
  echo_warn "DWEB_GIT_ALLOW_DIRECT_PUSH=1 检测到：允许绕过分支保护直接推送。"
  if [ "$SKIP_QUALITY" = "1" ]; then
    echo_warn "DWEB_SKIP_QUALITY_CHECK=1 检测到：跳过质量检查。"
    exit 0
  fi
  echo_info "运行质量检查..."
  check_prettier_format || exit 1
  if run_quality_checks; then
    echo_success "质量检查通过。"
    exit 0
  else
    echo_error "质量检查未通过，推送已取消。"
    echo "若确需跳过，请设置 DWEB_SKIP_QUALITY_CHECK=1"
    exit 1
  fi
fi

input_stdin="$(cat || true)"
if [ -z "${input_stdin}" ]; then
  echo_info "未检测到待推送的引用，跳过保护检测。"
  exit 0
fi

target_branch=""
while IFS= read -r line; do
  # shellcheck disable=SC2086
  set -- ${line}
  local_ref="$1"
  remote_ref="$3"
  branch_name="${remote_ref#refs/heads/}"
  for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [ "${branch_name}" = "${protected}" ]; then
      target_branch="${protected}"
      break 2
    fi
  done
done <<EOF
${input_stdin}
EOF

if [ -n "${target_branch}" ]; then
  echo_error "检测到向受保护分支『${target_branch}』的直接推送，已拒绝。"
  echo ""
  echo "工作流规则：main / dev 分支仅接受来自 Pull Request 的合并提交。"
  echo "请使用如下流程替代直接 push："
  echo ""
  echo "  1) 从 dev 拉取特性分支："
  echo "       git checkout dev"
  echo "       git pull origin dev"
  echo "       git checkout -b feature/<你的功能说明>"
  echo "  2) 在特性分支提交改动，推送到远端："
  echo "       git add ... && git commit ..."
  echo "       git push -u origin feature/<你的功能说明>"
  echo "  3) 在 Git 仓库平台（如 GitHub / Gitee）发起 Pull Request，"
  echo "     目标分支为 dev；待 Review / CI 通过后再由维护者合并。"
  echo ""
  echo "若你确实需要临时绕过该保护（例如紧急热修复），可一次性设置环境变量："
  echo ""
  echo "       DWEB_GIT_ALLOW_DIRECT_PUSH=1 git push origin dev"
  echo ""
  exit 1
fi

if [ "$SKIP_QUALITY" = "1" ]; then
  echo_warn "DWEB_SKIP_QUALITY_CHECK=1 检测到：跳过质量检查。"
  echo_info "未命中受保护分支 (main/dev)，推送继续。"
  exit 0
fi

# Pick the right Node toolchain for the current platform / shell.
# Windows-native "node.exe" is installed for PowerShell/CMD users; the
# quality checks (vue-tsc + vitest) rely on rollup optional native
# bindings (e.g. @rollup/rollup-win32-x64-msvc) published for win32.
# When pre-push runs under a non-Windows bash (e.g. WSL bash, MSYS2
# bash, or an accidental Git-for-Windows bash that leaks into a unixy
# PATH), `npm run quality` would instead pull in the linux-x64-gnu
# rollup binding which is typically NOT installed alongside the
# win32 one, causing the push to fail with "Cannot find module
# @rollup/rollup-linux-x64-gnu" even though the project itself is
# perfectly healthy on Windows.
#
# Detect this case and re-exec the quality check through the native
# Windows node/npm when available, so pre-push yields the same
# "pass/fail" result as the developer's local `npm run quality`
# run from PowerShell.
run_quality_checks() {
  local uname_s
  uname_s="$(uname -s 2>/dev/null || true)"
  local use_win_native=0
  case "${uname_s}" in
    Linux|linux*)
      # WSL 1 / WSL 2 exposing Windows host drives as /mnt/c/...
      if command -v node.exe >/dev/null 2>&1 && command -v npm.cmd >/dev/null 2>&1; then
        use_win_native=1
      fi
      ;;
    MINGW*|MSYS*|CYGWIN*)
      # Git Bash / MSYS2 / Cygwin on Windows
      if command -v node.exe >/dev/null 2>&1 && command -v npm.cmd >/dev/null 2>&1; then
        use_win_native=1
      fi
      ;;
  esac

  if [ "${use_win_native}" = "1" ]; then
    echo_info "检测到非 Windows 原生 Bash(${uname_s:-unknown})，改用 Windows 原生 npm.cmd 运行质量检查，避免 rollup 原生绑定平台不匹配。"
    npm.cmd run quality 2>&1 && return 0 || return 1
  fi

  npm run quality 2>&1 && return 0 || return 1
}

echo_info "运行质量检查 (prettier + typecheck + test)..."
check_prettier_format || exit 1
if run_quality_checks; then
  echo_success "质量检查通过。"
  echo_info "未命中受保护分支 (main/dev)，推送继续。"
  exit 0
else
  echo_error "质量检查未通过，推送已取消。"
  echo ""
  echo "请修复上述问题后再推送，或临时跳过检查："
  echo ""
  echo "       DWEB_SKIP_QUALITY_CHECK=1 git push"
  echo ""
  exit 1
fi
