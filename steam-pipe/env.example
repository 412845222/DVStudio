# Steam 构建环境变量配置示例
# 复制此文件为 .env 并填入实际值，或直接设置到系统环境变量中

# Steam App ID (必填)
# 开发测试阶段使用 SpaceWar AppID: 480
# 正式上架前替换为正式 AppID
STEAM_APP_ID=2475710

# Depot ID (上传时必填)
# 在 Steamworks 后台创建 Depot 后获取
STEAM_DEPOT_ID_WIN=2475711
STEAM_DEPOT_ID_MAC=
STEAM_DEPOT_ID_LINUX=

# Steam 构建账户 (上传时必填)
# 建议使用专用构建账户，仅授予必要权限
STEAM_USERNAME=
STEAM_PASSWORD=

# Steam Guard 验证码 (首次登录时必填)
# 启用 Steam Guard 的账户首次登录时需要提供验证码
# 首次成功登录后会生成 Sentry 文件，后续登录可能不需要
STEAM_GUARD_CODE=

# Steam 分支 (可选，默认为 beta)
# 设置为 "" 表示直接上线到公开分支（不推荐）
# 建议测试阶段使用 beta 分支
STEAM_BRANCH=beta
