{
  "name": "dweb-video-studio",
  "private": true,
  "version": "0.1.1",
  "main": "electron/main.mjs",
  "description": "DVStudio (Dweb Video Studio) - Vite + Vue 3 + TypeScript + WebGL2 视频动画模板/编辑器，支持时间轴关键帧与 AI 对话辅助生成/修改场景。",
  "license": "MIT",
  "author": "DwebStudio",
  "homepage": "https://www.dweb.club/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/412845222/DVStudio.git"
  },
  "bugs": {
    "url": "https://github.com/412845222/DVStudio/issues"
  },
  "funding": {
    "type": "url",
    "url": "https://space.bilibili.com/22690066"
  },
  "keywords": [
    "DVStudio",
    "dweb",
    "video",
    "animation",
    "editor",
    "timeline",
    "keyframes",
    "webgl2",
    "vue",
    "vite",
    "typescript"
  ],
  "engines": {
    "node": ">=16"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vite:5173": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:web": "cross-env VITE_PLATFORM=web VITE_BACKEND_BASE_URL=http://127.0.0.1:5800 DWEB_RESOURCE_DIR=DVSResource vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:web:empty": "cross-env VITE_PLATFORM=web DWEB_SIMULATE_EMPTY_ENV=1 VITE_BACKEND_BASE_URL=http://127.0.0.1:5800 DWEB_RESOURCE_DIR=DVSResource vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:web:all": "concurrently -k -n vite,django -c blue,yellow \"npm run dev:web\" \"npm run dev:django\"",
    "dev:web:all:py3": "concurrently -k -n vite,django -c blue,yellow \"npm run dev:web\" \"python3 django-app/manage.py runserver 5800\"",
    "dev:django": "python django-app/manage.py runserver 5800",
    "dev:backend:mac": "if [ -x ../../.venv/bin/python ]; then ../../.venv/bin/python django-app/manage.py runserver 5800; elif [ -x ../.venv/bin/python ]; then ../.venv/bin/python django-app/manage.py runserver 5800; else python django-app/manage.py runserver 5800; fi",
    "setup:django:mac": "if [ -x ../../.venv/bin/python ]; then ../../.venv/bin/python django-app/manage.py migrate; elif [ -x ../.venv/bin/python ]; then ../.venv/bin/python django-app/manage.py migrate; else python django-app/manage.py migrate; fi",
    "start:dev:mac": "concurrently -k -n vite,django \"npm run dev:vite:5173\" \"npm run dev:backend:mac\"",
    "check:copilot-sse": "node scripts/check-copilot-sse.mjs",
    "smoke:copilot-dev": "node scripts/run-copilot-dev-smoke.mjs",
    "dev:electron:app": "cross-env DWEB_FAIL_ON_REBUILD_ERROR=1 node scripts/rebuild-better-sqlite3.mjs && npx --no-install wait-on --timeout 30000 tcp:127.0.0.1:5173 && cross-env DWEB_RESOURCE_DIR=DVSResource ELECTRON_DEV=1 ELECTRON_RENDERER_URL=http://127.0.0.1:5173/ npx --no-install electron electron/main.mjs",
    "dev:electron:app:empty": "cross-env DWEB_FAIL_ON_REBUILD_ERROR=1 node scripts/rebuild-better-sqlite3.mjs && npx --no-install wait-on --timeout 30000 tcp:127.0.0.1:5173 && cross-env DWEB_RESOURCE_DIR=DVSResource DWEB_SIMULATE_EMPTY_ENV=1 ELECTRON_DEV=1 ELECTRON_RENDERER_URL=http://127.0.0.1:5173/ npx --no-install electron electron/main.mjs",
    "dev:electron": "cross-env DWEB_FAIL_ON_REBUILD_ERROR=1 node scripts/rebuild-better-sqlite3.mjs && node scripts/setup-steam-native.mjs && concurrently -k -n vite,electron \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"npx --no-install wait-on --timeout 30000 tcp:127.0.0.1:5173 && cross-env DWEB_RESOURCE_DIR=DVSResource ELECTRON_DEV=1 DWEB_STEAMJS_DEBUG=1 ELECTRON_RENDERER_URL=http://127.0.0.1:5173/ npx --no-install electron electron/main.mjs\"",
    "dev:electron:empty": "cross-env DWEB_FAIL_ON_REBUILD_ERROR=1 node scripts/rebuild-better-sqlite3.mjs && concurrently -k -n vite,electron \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"npx --no-install wait-on --timeout 30000 tcp:127.0.0.1:5173 && cross-env DWEB_RESOURCE_DIR=DVSResource DWEB_SIMULATE_EMPTY_ENV=1 ELECTRON_DEV=1 ELECTRON_RENDERER_URL=http://127.0.0.1:5173/ npx --no-install electron electron/main.mjs\"",
    "install:better-sqlite3": "cross-env DWEB_FAIL_ON_REBUILD_ERROR=1 node scripts/rebuild-better-sqlite3.mjs",
    "setup:steam": "node scripts/setup-steam-dev.mjs",
    "clean:runtime-django": "node scripts/clean-runtime-django.mjs",
    "build": "vue-tsc && vite build",
    "gen:win-icon": "node scripts/gen-win-icon.mjs",
    "gen:installer-bitmaps": "node scripts/gen-installer-bitmaps.mjs",
    "prepare:python-runtime": "node scripts/prepare-python-runtime.mjs",
    "clean:source-pack": "node scripts/remove-dir.mjs release-source",
    "pack:source": "node scripts/pack-source.mjs",
    "clean:lan-pack": "node scripts/remove-dir.mjs release-transfer",
    "pack:lan": "node scripts/pack-lan-transfer.mjs",
    "pack:lan:with-dvs": "node scripts/pack-lan-transfer.mjs --include-dvs-resource",
    "pack:git-bundle": "node scripts/create-git-bundle.mjs",
    "clean:sample-pack": "node scripts/remove-dir.mjs release-sample",
    "pack:sample": "node scripts/pack-sample.mjs",
    "perf:analyze:chrome": "node scripts/perf/analyze-chrome-perf.mjs",
    "perf:scan:large": "node scripts/perf/scan-large-text.mjs",
    "perf:aiwf:generate": "node scripts/perf/aiwf-generate-image-blueprint.mjs",
    "perf:aiwf:audit-preview": "node scripts/perf/aiwf-asset-preview-audit.mjs",
    "perf:aiwf:smoke": "node scripts/perf/aiwf-pan-perf-smoke.mjs",
    "perf:aiwf:smoke:batch": "node scripts/perf/aiwf-pan-perf-smoke.mjs --batch S0,S1,S2,S3",
    "prepack:win": "npm run gen:win-icon",
    "pack:win": "npm run build && electron-builder --dir -w",
    "pack:mac": "npm run build && electron-builder --dir -m",
    "predist:win": "npm run prepare:python-runtime && npm run gen:win-icon && npm run gen:installer-bitmaps",
    "dist:win": "node scripts/dist-win.mjs",
    "dist:mac": "node scripts/dist-mac.mjs",
    "preview": "vite preview",
    "git:setup-hooks": "git config core.hooksPath .githooks",
    "git:unset-hooks": "git config --unset core.hooksPath",
    "git:protect-on": "npm run git:setup-hooks",
    "git:protect-off": "npm run git:unset-hooks",
    "postinstall": "node scripts/rebuild-better-sqlite3.mjs && node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"electron/**/*.{mjs,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" \"electron/**/*.{mjs,js}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"electron/**/*.{mjs,js,json}\" \"scripts/**/*.{mjs,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"electron/**/*.{mjs,js,json}\" \"scripts/**/*.{mjs,js}\"",
    "quality": "npm run typecheck && npm run test",
    "quality:full": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.0",
    "three": "^0.183.2",
    "vue": "^3.2.41",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.2",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "^3.2.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^24.0.0",
    "png-to-ico": "^2.1.8",
    "prettier": "^3.8.4",
    "typescript": "^4.6.4",
    "vite": "^3.2.3",
    "vitest": "^2.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "1.0.9",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "club.dweb.dvstudio",
    "productName": "Dweb Video Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/static/runtime/**",
      "public/favicon.ico"
    ],
    "extraResources": [
      {
        "from": "django-app",
        "to": "django-app"
      },
      {
        "from": "electron/static",
        "to": "static",
        "filter": [
          "**/*",
          "!runtime/**"
        ]
      },
      {
        "from": "electron/static/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dweb Video Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/uninstaller-sidebar.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh-CN",
        "en-US"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false
    }
  }
}
