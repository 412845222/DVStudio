# ============================================================
# SteamPipe build & upload (NEVER commit this directory)
# ============================================================
# The entire steam-pipe/ directory is local-only (build outputs, credentials, logs).
# VDF templates are inlined in scripts/upload-steam.mjs; do not track any files here.
steam-pipe/

# ============================================================
# Steam local configuration & private implementation
# ============================================================
# steam.config.json contains the real Steam AppID (do NOT commit anywhere).
# Example template is in electron/platform/steam.config.example.json.
# Root directory must NOT contain steam config files.
steam.config.json
/steam.config.example.json

# Private platform/provider implementations (*.local.cjs / *.local.mjs)
# contain sensitive integration details that must not be pushed to public repos.
# The public stubs (e.g. steam.mjs) will gracefully fall back to disabled state
# when the local implementation file is absent.
*.local.cjs
*.local.mjs

# ============================================================
# Admin Publisher Tool (NEVER commit this directory)
# ============================================================
# Official template publisher backend tool (operator-only).
# Contains Steam publishing credentials and operational code that must not be leaked.
admin-publisher/
admin-publisher/node_modules/
admin-publisher/dist/
admin-publisher/.env
